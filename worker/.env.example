# =============================================================================
# WORKER — variables de entorno
# Copiar a .env y reemplazar los valores "changeme":   cp .env.example .env
# .env está en .gitignore: nunca se versiona.
# Formato: VARIABLE=valor   (sin espacios alrededor del "=" ni comentarios al final)
# =============================================================================

# ── Imagen (igual que en el master) ──────────────────────────────────────────
AIRFLOW_VERSION=2.9.3
PYTHON_VERSION=3.12
AIRFLOW_IMAGE_NAME=airflow-celery:2.9.3

# ── Servidor ─────────────────────────────────────────────────────────────────
# Mismo UID que en el master (dueño de los archivos compartidos por NFS)
AIRFLOW_UID=50000
# Misma ruta que en el master; dags/logs/plugins son el montaje NFS
AIRFLOW_DATA_DIR=/app/dockerdata/airflow

# ── Conexión al master ───────────────────────────────────────────────────────
# Host o IP del master (donde corren Redis y PostgreSQL)
MASTER_HOST=changeme-master-host
REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# ── Claves de Airflow: COPIAR LAS MISMAS DEL .env DEL MASTER ─────────────────
AIRFLOW_FERNET_KEY=copiar_del_master
AIRFLOW_SECRET_KEY=copiar_del_master

# ── Worker (ver README, "Variables ajustables") ─────────────────────────────
# Colas que atiende este worker, separadas por coma (ej: default o pesado)
WORKER_QUEUES=default
# Tareas simultáneas en este worker
WORKER_CONCURRENCY=16
# Puerto por el que el webserver pide los logs en vivo (abrir en el firewall)
WORKER_LOG_SERVER_PORT=8793

# ── SMTP para alertas por correo (igual que en el master) ───────────────────
AIRFLOW_SMTP_HOST=smtp.example.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_STARTTLS=True
AIRFLOW_SMTP_SSL=False
AIRFLOW_SMTP_USER=alertas@example.com
AIRFLOW_SMTP_PASSWORD=changeme
AIRFLOW_SMTP_MAIL_FROM=alertas@example.com

# ── Oracle Instant Client (solo con docker-compose.oracle.yml) ──────────────
ORACLE_HOST_LIB_DIR=/usr/lib/oracle
ORACLE_HOST_TNS_DIR=/opt/oracle
ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/instantclient_23_26
