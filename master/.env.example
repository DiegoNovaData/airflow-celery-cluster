# =============================================================================
# MASTER — variables de entorno
# Copiar a .env y reemplazar los valores "changeme":   cp .env.example .env
# .env está en .gitignore: nunca se versiona.
# Formato: VARIABLE=valor   (sin espacios alrededor del "=" ni comentarios al final)
# =============================================================================

# ── Imagen ───────────────────────────────────────────────────────────────────
AIRFLOW_VERSION=2.9.3
PYTHON_VERSION=3.12
AIRFLOW_IMAGE_NAME=airflow-celery:2.9.3
POSTGRES_IMAGE=postgres:14
REDIS_IMAGE=redis:7

# ── IPs del cluster ──────────────────────────────────────────────────────────
# IP del master: los puertos (8080, 5555, 6379, 5432) se publican solo en ella.
MASTER_IP=192.0.2.10
# IPs de los workers separadas por coma. Las usan los comandos de firewall y
# NFS de docs/ (se cargan con: set -a; source .env; set +a).
WORKER_IPS=192.0.2.41,192.0.2.42

# ── Servidor ─────────────────────────────────────────────────────────────────
# UID con el que corren los contenedores. Debe ser dueño de AIRFLOW_DATA_DIR
# y ser el MISMO en master y workers (los archivos se comparten por NFS).
AIRFLOW_UID=50000
# Carpeta base en el host (dags, logs, plugins, postgres, ssh, postgres_backup)
AIRFLOW_DATA_DIR=/app/dockerdata/airflow

# ── Puertos publicados en el master ──────────────────────────────────────────
AIRFLOW_WEBSERVER_PORT=8080
FLOWER_PORT=5555
REDIS_PORT=6379
POSTGRES_PORT=5432

# URL de la UI (enlaces en los correos). Usa un nombre DNS si lo tienes.
AIRFLOW_BASE_URL=http://${MASTER_IP}:${AIRFLOW_WEBSERVER_PORT}

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# ── Claves de Airflow (las MISMAS en master y en todos los workers) ─────────
# Fernet key:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generar_con_fernet_key
# Secret key:  python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=generar_con_secrets_token_hex

# ── Usuario admin de la UI (lo crea airflow-init la primera vez) ────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ── Concurrencia (ver README, "Variables ajustables") ───────────────────────
AIRFLOW_PARALLELISM=32
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW_MAX_ACTIVE_RUNS_PER_DAG=16
AIRFLOW_MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW_WEBSERVER_WORKERS=2

# ── SMTP para alertas por correo ─────────────────────────────────────────────
AIRFLOW_SMTP_HOST=smtp.example.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_STARTTLS=True
AIRFLOW_SMTP_SSL=False
AIRFLOW_SMTP_USER=alertas@example.com
AIRFLOW_SMTP_PASSWORD=changeme
AIRFLOW_SMTP_MAIL_FROM=alertas@example.com

# ── Flower ───────────────────────────────────────────────────────────────────
# "usuario:clave" para pedir login en la UI de Flower. Vacío = sin login.
FLOWER_BASIC_AUTH=admin:changeme

# ── Instalación dinámica de paquetes ─────────────────────────────────────────
# Deshabilitada a propósito. Librerías nuevas van en requirements.txt y se
# reconstruye la imagen: docker compose build
